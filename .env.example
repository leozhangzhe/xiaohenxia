# Documentation only: the application does NOT automatically load .env files.
# Prefer 双击启动.bat: random local database password protected with Windows DPAPI.
# Advanced external-MySQL mode: set values in the current process environment.
SF_AUTH_MYSQL_HOST=127.0.0.1
SF_AUTH_MYSQL_PORT=3306
SF_AUTH_MYSQL_DATABASE=xiaohenxia_competition
SF_AUTH_MYSQL_USER=your_dedicated_mysql_user
SF_AUTH_MYSQL_PASSWORD=
SF_AUTH_ADMIN_USER=admin
SF_AUTH_ADMIN_PASS=
SF_AUTH_ADMIN_RESET=0
SF_AUTH_COOKIE_SECURE=0
SF_HIBP_API_KEY=
# SF_AUTH_COOKIE_SECURE=1 requires HTTPS. Never commit filled credentials.
