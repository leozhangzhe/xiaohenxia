<%include file="HEADER.tmpl"/>

<div class="pg-fade-in" style="display:flex;align-items:center;justify-content:center;min-height:60vh;">
  <div style="text-align:center;max-width:480px;">
    <div style="width:80px;height:80px;background:rgba(239,68,68,0.1);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent-red)" stroke-width="2" width="36" height="36">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8" x2="12" y2="12"/>
        <line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
    </div>
    <h2 style="font-size:20px;font-weight:700;color:var(--text-primary);margin-bottom:12px;">${context.get('error_title', '发生了一个错误') | h}</h2>
    <div class="pg-alert pg-alert-danger" style="text-align:left;margin-bottom:20px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" style="flex-shrink:0;"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
      <div>${message | h}</div>
    </div>
    <p style="font-size:13px;color:var(--text-muted);margin-bottom:24px;">
      ${context.get('error_hint', '请返回重试。如果您确认这是一个程序错误，欢迎反馈。') | h}
    </p>
    <a href="javascript:history.back()" class="pg-btn pg-btn-primary" style="margin-right:10px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><polyline points="15 18 9 12 15 6"/></svg>
      返回上一页
    </a>
    <a href="${docroot}/" class="pg-btn pg-btn-ghost">回到首页</a>
  </div>
</div>

<%include file="FOOTER.tmpl"/>
