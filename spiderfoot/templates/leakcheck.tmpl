<%include file="HEADER.tmpl"/>

<div class="pg-page-header pg-fade-in">
  <h1 class="pg-page-title">泄露检测</h1>
  <p class="pg-page-subtitle">查询当前本地数据源中已收录的泄露记录</p>
  <p class="pg-hint-text">当前数据源：本地 SQLite 合成样例库。仅检索本地合成演示数据；覆盖范围有限，不是实时互联网查询。无匹配不代表安全，结果需要人工核验。</p>
  % if source_unavailable:
  <p class="pg-alert pg-alert-danger">数据源不可用，请检查本地数据源后重试。</p>
  % endif
</div>

<!-- 搜索表单 -->
<div class="pg-card pg-fade-in" style="margin-bottom: 20px;">
  <div class="pg-card-header">
    <div class="pg-card-title">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      信息泄露查询
    </div>
  </div>
  <div class="pg-card-body">
    <div style="display: flex; gap: 12px; align-items: flex-end;">
      <div style="flex: 1;">
        <label class="pg-label" for="leak-query">查询内容</label>
        <input class="pg-input" type="text" id="leak-query" placeholder="输入手机号、邮箱、身份证号或 QQ 号" autocomplete="off"/>
      </div>
      <button class="pg-btn pg-btn-primary" id="leak-search-btn" onclick="doLeakSearch()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        检测泄露
      </button>
    </div>
    <div style="margin-top: 10px; display: flex; gap: 16px; flex-wrap: wrap;">
      <span class="pg-hint-text">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        手机号：11位数字
      </span>
      <span class="pg-hint-text">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        邮箱：example@domain.com
      </span>
      <span class="pg-hint-text">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        身份证：18位
      </span>
      <span class="pg-hint-text">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        QQ号：5-11位数字
      </span>
    </div>
  </div>
</div>

<!-- 加载中 -->
<div id="leak-loading" style="display: none; text-align: center; padding: 40px;">
  <div class="pg-spinner" style="margin: 0 auto 12px;"></div>
  <p style="color: var(--text-muted);">正在查询本地 SQLite 数据源...</p>
</div>

<!-- 查询结果 -->
<div id="leak-result" style="display: none;"></div>

<!-- 未找到结果 -->
<div id="leak-notfound" style="display: none;">
  <div class="pg-card pg-fade-in" style="text-align: center; padding: 40px;">
    <div style="width: 64px; height: 64px; background: rgba(59,130,246,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent-blue)" stroke-width="2" width="32" height="32">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
    </div>
    <h3 style="font-size: 18px; font-weight: 600; color: var(--text-primary); margin-bottom: 8px;">未发现匹配</h3>
    <p style="color: var(--text-muted);">当前数据源未发现匹配，不代表不存在相关信息。</p>
  </div>
</div>

<!-- 错误提示 -->
<div id="leak-error" style="display: none;">
  <div class="pg-card pg-fade-in">
    <div class="pg-alert pg-alert-danger">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
        <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
      </svg>
      <div id="leak-error-msg"></div>
    </div>
  </div>
</div>

<script>
var docroot = '${docroot}';

function doLeakSearch() {
  var query = document.getElementById('leak-query').value.trim();
  if (!query) {
    alertify.error('请输入查询内容');
    return;
  }

  // 显示加载，隐藏结果
  document.getElementById('leak-loading').style.display = 'block';
  document.getElementById('leak-result').style.display = 'none';
  document.getElementById('leak-notfound').style.display = 'none';
  document.getElementById('leak-error').style.display = 'none';
  document.getElementById('leak-search-btn').disabled = true;

  fetch(docroot + '/leaksearch', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
    body: new URLSearchParams({ q: query })
  })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      document.getElementById('leak-loading').style.display = 'none';
      document.getElementById('leak-search-btn').disabled = false;

      if (data.error) {
        document.getElementById('leak-error').style.display = 'block';
        document.getElementById('leak-error-msg').textContent = data.error;
        return;
      }

      if (!data.found) {
        document.getElementById('leak-notfound').style.display = 'block';
        return;
      }

      // 构建结果面板
      var html = '';

      // 概要卡片
      html += '<div class="pg-card pg-fade-in" style="margin-bottom: 16px; border-left: 4px solid var(--accent-red);">';
      html += '<div class="pg-card-header"><div class="pg-card-title" style="color: var(--accent-red);">';
      html += '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
      html += '发现泄露记录</div></div>';
      html += '<div class="pg-card-body">';
      html += '<div style="display: flex; gap: 24px; flex-wrap: wrap;">';
      html += '<div><span style="color: var(--text-muted); font-size: 13px;">关联记录数</span><div style="font-size: 24px; font-weight: 700; color: var(--accent-red);">' + data.total_records + '</div></div>';
      html += '<div><span style="color: var(--text-muted); font-size: 13px;">泄露来源数</span><div style="font-size: 24px; font-weight: 700; color: var(--accent-yellow);">' + data.source_count + '</div></div>';
      html += '<div><span style="color: var(--text-muted); font-size: 13px;">查询类型</span><div style="font-size: 24px; font-weight: 700;">' + getTypeLabel(data.query_type) + '</div></div>';
      html += '</div>';
      if (data.sources && data.sources.length > 0) {
        html += '<div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border-color);">';
        html += '<span style="color: var(--text-muted); font-size: 13px;">泄露来源：</span>';
        html += data.sources.map(function(s) { return '<span class="pg-tag pg-tag-warning" style="margin: 2px;">' + escapeHtml(s) + '</span>'; }).join('');
        html += '</div>';
      }
      html += '</div></div>';

      // 详细信息卡片
      var fieldLabels = {
        'name': { label: '姓名', icon: 'user' },
        'phone': { label: '手机号', icon: 'phone' },
        'email': { label: '邮箱', icon: 'mail' },
        'qq': { label: 'QQ号', icon: 'message' },
        'weibo': { label: '微博', icon: 'message' },
        'id': { label: '身份证', icon: 'credit-card' },
        'address': { label: '地址', icon: 'map-pin' },
        'car': { label: '车辆信息', icon: 'truck' },
        'company': { label: '公司', icon: 'building' },
        'receiver': { label: '收件人', icon: 'user' },
        'nickname': { label: '昵称', icon: 'user' },
        'contact': { label: '联系方式', icon: 'phone' }
      };

      html += '<div class="pg-card pg-fade-in">';
      html += '<div class="pg-card-header"><div class="pg-card-title">';
      html += '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>';
      html += '脱敏泄露详情</div></div>';
      html += '<div class="pg-card-body">';

      var d = data.data;
      var hasDetail = false;
      for (var field in fieldLabels) {
        if (d[field] && d[field].length > 0) {
          hasDetail = true;
          html += '<div class="pg-leak-field">';
          html += '<div class="pg-leak-field-label">' + fieldLabels[field].label + '</div>';
          html += '<div class="pg-leak-field-values">';
          d[field].forEach(function(val) {
            html += '<span class="pg-leak-value-tag">' + escapeHtml(val) + '</span>';
          });
          html += '</div></div>';
        }
      }

      if (!hasDetail) {
        html += '<p style="color: var(--text-muted);">暂无详细脱敏数据</p>';
      }

      html += '</div></div>';

      // 安全提示
      html += '<div class="pg-alert pg-alert-warning pg-fade-in" style="margin-top: 16px;">';
      html += '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
      html += '<div>以上数据已进行脱敏处理。如发现信息泄露，建议尽快修改相关密码并启用二次验证。</div>';
      html += '</div>';

      document.getElementById('leak-result').innerHTML = html;
      document.getElementById('leak-result').style.display = 'block';
    })
    .catch(function(err) {
      document.getElementById('leak-loading').style.display = 'none';
      document.getElementById('leak-search-btn').disabled = false;
      document.getElementById('leak-error').style.display = 'block';
      document.getElementById('leak-error-msg').textContent = '查询失败，请稍后重试';
    });
}

function getTypeLabel(type) {
  var labels = { 'phone': '手机号', 'email': '邮箱', 'id': '身份证', 'qq': 'QQ号' };
  return labels[type] || type;
}

function escapeHtml(str) {
  if (!str) return '';
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// 回车键触发搜索
document.getElementById('leak-query').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') doLeakSearch();
});
</script>

<%include file="FOOTER.tmpl"/>
