<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>注册 - 消痕侠 数字痕迹管理平台</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; font-family: 'Inter', -apple-system, sans-serif; }

    body {
      min-height: 100vh;
      background: #f0f4ff;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    /* 背景网格纹理 */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(37,99,235,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(37,99,235,0.04) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
    }

    /* 右上角装饰大圆 */
    body::after {
      content: '';
      position: fixed;
      top: -200px; right: -200px;
      width: 600px; height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(124,58,237,0.08) 0%, transparent 70%);
      pointer-events: none;
    }

    .reg-bg-circle-2 {
      position: fixed;
      bottom: -150px; left: -150px;
      width: 500px; height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(37,99,235,0.07) 0%, transparent 70%);
      pointer-events: none;
    }

    /* 整体容器 */
    .reg-wrap {
      position: relative;
      z-index: 1;
      width: 100%;
      padding: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
    }

    .reg-container {
      display: flex;
      width: 100%;
      max-width: 960px;
      background: #ffffff;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 24px 80px rgba(15,23,42,0.12), 0 0 0 1px rgba(226,232,245,0.8);
    }

    /* ── 左侧品牌区 ── */
    .reg-brand {
      flex: 1;
      background: linear-gradient(145deg, #1e40af 0%, #2563eb 40%, #7c3aed 100%);
      padding: 48px 40px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }

    .reg-brand::before {
      content: '';
      position: absolute;
      top: -80px; right: -80px;
      width: 280px; height: 280px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.1);
    }
    .reg-brand::after {
      content: '';
      position: absolute;
      bottom: -60px; left: -60px;
      width: 240px; height: 240px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.08);
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 14px;
      position: relative;
      z-index: 1;
    }

    .brand-logo-icon {
      width: 52px; height: 52px;
      background: rgba(255,255,255,0.15);
      border: 1.5px solid rgba(255,255,255,0.3);
      border-radius: 16px;
      display: flex; align-items: center; justify-content: center;
      backdrop-filter: blur(8px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.2);
    }

    .brand-name {
      font-size: 26px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.5px;
      line-height: 1;
    }

    .brand-tagline {
      font-size: 11px;
      color: rgba(255,255,255,0.65);
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-top: 4px;
    }

    .brand-steps {
      position: relative;
      z-index: 1;
    }

    .brand-steps h2 {
      font-size: 22px;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 8px;
      line-height: 1.3;
    }

    .brand-steps p {
      font-size: 13px;
      color: rgba(255,255,255,0.65);
      line-height: 1.7;
      margin-bottom: 28px;
    }

    .step-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .step-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }

    .step-num {
      width: 26px; height: 26px;
      border-radius: 50%;
      background: rgba(255,255,255,0.2);
      border: 1.5px solid rgba(255,255,255,0.4);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
      font-size: 12px;
      font-weight: 700;
      color: #fff;
      margin-top: 1px;
    }

    .step-text {
      font-size: 13px;
      color: rgba(255,255,255,0.85);
      line-height: 1.55;
    }
    .step-text strong {
      color: #fff;
      font-weight: 600;
    }

    .brand-footer {
      position: relative;
      z-index: 1;
      font-size: 11px;
      color: rgba(255,255,255,0.4);
    }

    /* ── 右侧表单区 ── */
    .reg-form-area {
      width: 420px;
      flex-shrink: 0;
      padding: 48px 44px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .reg-form-header {
      margin-bottom: 32px;
    }

    .reg-form-title {
      font-size: 26px;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: -0.5px;
      margin-bottom: 6px;
    }

    .reg-form-sub {
      font-size: 13px;
      color: #64748b;
      line-height: 1.6;
    }

    /* 消息提示 */
    .reg-error {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(239,68,68,0.07);
      border: 1px solid rgba(239,68,68,0.2);
      border-left: 4px solid #ef4444;
      border-radius: 8px;
      padding: 12px 14px;
      margin-bottom: 22px;
      font-size: 13px;
      color: #991b1b;
    }

    .reg-success {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(34,197,94,0.07);
      border: 1px solid rgba(34,197,94,0.2);
      border-left: 4px solid #22c55e;
      border-radius: 8px;
      padding: 12px 14px;
      margin-bottom: 22px;
      font-size: 13px;
      color: #166534;
    }

    /* 表单组 */
    .form-group {
      margin-bottom: 18px;
      position: relative;
    }

    .form-label {
      display: block;
      font-size: 11px;
      font-weight: 700;
      color: #475569;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .form-input-wrap {
      position: relative;
    }

    .form-input-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #94a3b8;
      pointer-events: none;
      display: flex;
      align-items: center;
    }

    .form-input {
      width: 100%;
      background: #f8faff;
      border: 1.5px solid #e2e8f5;
      border-radius: 10px;
      padding: 13px 44px 13px 42px;
      font-size: 14px;
      font-family: inherit;
      color: #0f172a;
      outline: none;
      transition: all 0.2s;
    }
    .form-input::placeholder { color: #94a3b8; }
    .form-input:focus {
      border-color: #2563eb;
      background: #ffffff;
      box-shadow: 0 0 0 4px rgba(37,99,235,0.1);
    }
    .form-input.input-valid {
      border-color: #22c55e;
      background: #ffffff;
    }
    .form-input.input-error {
      border-color: #ef4444;
      background: #fff8f8;
    }

    /* 密码可见切换 */
    .toggle-pw {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      color: #94a3b8;
      padding: 0;
      display: flex;
      align-items: center;
      transition: color 0.15s;
    }
    .toggle-pw:hover { color: #2563eb; }

    /* 密码强度条 */
    .pw-strength {
      margin-top: 8px;
      display: none;
    }
    .pw-strength-bar {
      display: flex;
      gap: 4px;
      margin-bottom: 4px;
    }
    .pw-bar-seg {
      flex: 1;
      height: 3px;
      border-radius: 2px;
      background: #e2e8f0;
      transition: background 0.3s;
    }
    .pw-strength-text {
      font-size: 11px;
      color: #94a3b8;
      transition: color 0.3s;
    }

    /* 密码匹配提示 */
    .confirm-hint {
      font-size: 11px;
      margin-top: 6px;
      min-height: 16px;
    }

    /* 提交按钮 */
    .btn-register {
      width: 100%;
      background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 14px;
      font-size: 15px;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 4px 16px rgba(37,99,235,0.35);
      position: relative;
      overflow: hidden;
      letter-spacing: 0.2px;
      margin-top: 6px;
    }

    .btn-register::before {
      content: '';
      position: absolute;
      top: 0; left: -100%; width: 60%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
      transition: left 0.5s;
    }
    .btn-register:hover::before { left: 150%; }
    .btn-register:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 28px rgba(37,99,235,0.45);
    }
    .btn-register:active { transform: translateY(0); }

    /* 底部 */
    .reg-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 28px;
    }

    .version-tag {
      font-size: 11px;
      color: #94a3b8;
      background: #f1f5f9;
      padding: 3px 9px;
      border-radius: 5px;
      border: 1px solid #e2e8f5;
    }

    /* 响应式 */
    @media (max-width: 760px) {
      .reg-brand { display: none; }
      .reg-form-area { width: 100%; padding: 40px 28px; }
    }
  </style>
</head>
<body>
  <div class="reg-bg-circle-2"></div>

  <div class="reg-wrap">
    <div class="reg-container">

      <!-- 左侧品牌区 -->
      <div class="reg-brand">
        <div class="brand-logo">
          <div class="brand-logo-icon">
            <svg width="26" height="26" viewBox="0 0 26 26" fill="none">
              <path d="M13 2L3.5 6.2V13c0 5.3 4.1 10.2 9.5 11.4C18.4 23.2 22.5 18.3 22.5 13V6.2L13 2z"
                fill="rgba(255,255,255,0.2)" stroke="rgba(255,255,255,0.9)" stroke-width="1.6" stroke-linejoin="round"/>
              <circle cx="13" cy="13" r="4" stroke="rgba(255,255,255,0.9)" stroke-width="1.6"/>
              <line x1="13" y1="6.5" x2="13" y2="9"  stroke="rgba(255,255,255,0.9)" stroke-width="1.6" stroke-linecap="round"/>
              <line x1="13" y1="17" x2="13" y2="19.5" stroke="rgba(255,255,255,0.9)" stroke-width="1.6" stroke-linecap="round"/>
              <line x1="6.5" y1="13" x2="9"  y2="13" stroke="rgba(255,255,255,0.9)" stroke-width="1.6" stroke-linecap="round"/>
              <line x1="17"  y1="13" x2="19.5" y2="13" stroke="rgba(255,255,255,0.9)" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <div class="brand-name">消痕侠</div>
            <div class="brand-tagline">数字痕迹管理平台</div>
          </div>
        </div>

        <div class="brand-steps">
          <h2>三步开始<br>守护隐私</h2>
          <p>创建账号后，你就可以立刻扫描全网公开的个人信息，掌握你的数字痕迹全貌。</p>
          <ul class="step-list">
            <li class="step-item">
              <span class="step-num">1</span>
              <div class="step-text"><strong>创建账号</strong><br>设置用户名和安全密码，30 秒完成注册</div>
            </li>
            <li class="step-item">
              <span class="step-num">2</span>
              <div class="step-text"><strong>发起扫描</strong><br>输入昵称、手机或邮箱，全网信息一键扫描</div>
            </li>
            <li class="step-item">
              <span class="step-num">3</span>
              <div class="step-text"><strong>处置痕迹</strong><br>查看风险告警，一键申请脱敏或删除</div>
            </li>
          </ul>
        </div>

        <div class="brand-footer">© 2026 消痕侠 · 保护您的数字隐私安全</div>
      </div>

      <!-- 右侧表单区 -->
      <div class="reg-form-area">
        <div class="reg-form-header">
          <h1 class="reg-form-title">创建账号</h1>
          <p class="reg-form-sub">加入消痕侠，开始守护你的数字隐私</p>
        </div>

        % if error:
        <div class="reg-error">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
          </svg>
          ${error}
        </div>
        % endif

        % if success:
        <div class="reg-success">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          ${success}&nbsp;
          <a href="${docroot}/login" style="color:#166534;font-weight:600;text-decoration:underline;margin-left:4px;">立即登录 →</a>
        </div>
        % endif

        <form method="post" action="${docroot}/register" id="reg-form">
          <input type="hidden" name="csrf_token" value="${csrf_token}">
          <!-- 用户名 -->
          <div class="form-group">
            <label class="form-label" for="username">用户名</label>
            <div class="form-input-wrap">
              <span class="form-input-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
              </span>
              <input id="username" name="username" type="text" class="form-input"
                placeholder="3-20 个字符，支持字母/数字/下划线" required autocomplete="username"
                style="padding-right:14px;">
            </div>
          </div>

          <!-- 密码 -->
          <div class="form-group">
            <label class="form-label" for="password">密码</label>
            <div class="form-input-wrap">
              <span class="form-input-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              </span>
              <input id="password" name="password" type="password" class="form-input"
                placeholder="至少 8 位，包含字母和数字" required autocomplete="new-password"
                oninput="checkStrength(this.value)">
              <button type="button" class="toggle-pw" onclick="togglePw('password','icon-pw1')">
                <svg id="icon-pw1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
              </button>
            </div>
            <!-- 密码强度 -->
            <div class="pw-strength" id="pw-strength">
              <div class="pw-strength-bar">
                <div class="pw-bar-seg" id="bar1"></div>
                <div class="pw-bar-seg" id="bar2"></div>
                <div class="pw-bar-seg" id="bar3"></div>
                <div class="pw-bar-seg" id="bar4"></div>
              </div>
              <span class="pw-strength-text" id="pw-strength-text">请输入密码</span>
            </div>
          </div>

          <!-- 确认密码 -->
          <div class="form-group">
            <label class="form-label" for="confirm">确认密码</label>
            <div class="form-input-wrap">
              <span class="form-input-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <polyline points="9 11 12 14 22 4"/>
                  <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                </svg>
              </span>
              <input id="confirm" name="confirm" type="password" class="form-input"
                placeholder="再次输入密码" required autocomplete="new-password"
                oninput="checkConfirm()">
              <button type="button" class="toggle-pw" onclick="togglePw('confirm','icon-pw2')">
                <svg id="icon-pw2" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
              </button>
            </div>
            <div class="confirm-hint" id="confirm-hint"></div>
          </div>

          <button class="btn-register" type="submit">创建账号</button>
        </form>

        <div class="reg-footer">
          <span class="version-tag">v${version}</span>
          <a href="${docroot}/login" style="text-decoration:none;color:#2563eb;font-weight:600;font-size:13px;">
            已有账号？立即登录 →
          </a>
        </div>
      </div>

    </div>
  </div>

  <script>
    // 密码可见切换
    function togglePw(inputId, iconId) {
      var input = document.getElementById(inputId);
      var icon  = document.getElementById(iconId);
      var show  = input.type === 'password';
      input.type = show ? 'text' : 'password';
      icon.innerHTML = show
        ? '<line x1="1" y1="1" x2="23" y2="23"/><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>'
        : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
    }

    // 密码强度检测
    function checkStrength(val) {
      var wrap = document.getElementById('pw-strength');
      wrap.style.display = val.length ? 'block' : 'none';
      if (!val.length) return;

      var score = 0;
      if (val.length >= 8)  score++;
      if (val.length >= 12) score++;
      if (/[A-Za-z]/.test(val) && /[0-9]/.test(val)) score++;
      if (/[^A-Za-z0-9]/.test(val)) score++;

      var colors = ['#ef4444','#f59e0b','#3b82f6','#22c55e'];
      var labels = ['弱','一般','较强','强'];
      for (var i = 0; i < 4; i++) {
        document.getElementById('bar' + (i+1)).style.background = i < score ? colors[score-1] : '#e2e8f0';
      }
      var txt = document.getElementById('pw-strength-text');
      txt.textContent = '密码强度：' + (labels[score-1] || '弱');
      txt.style.color  = colors[score-1] || '#ef4444';

      // 同步刷新确认密码
      checkConfirm();
    }

    // 确认密码匹配
    function checkConfirm() {
      var pw  = document.getElementById('password').value;
      var cfm = document.getElementById('confirm').value;
      var hint = document.getElementById('confirm-hint');
      var input = document.getElementById('confirm');
      if (!cfm) {
        hint.textContent = '';
        input.className = 'form-input';
        return;
      }
      if (pw === cfm) {
        hint.innerHTML = '<span style="color:#22c55e;">✓ 密码一致</span>';
        input.className = 'form-input input-valid';
      } else {
        hint.innerHTML = '<span style="color:#ef4444;">✕ 密码不一致</span>';
        input.className = 'form-input input-error';
      }
    }

    // 提交前校验
    document.getElementById('reg-form').addEventListener('submit', function(e) {
      var pw  = document.getElementById('password').value;
      var cfm = document.getElementById('confirm').value;
      if (pw !== cfm) {
        e.preventDefault();
        document.getElementById('confirm-hint').innerHTML = '<span style="color:#ef4444;">✕ 两次密码输入不一致，请检查</span>';
        document.getElementById('confirm').className = 'form-input input-error';
        document.getElementById('confirm').focus();
      }
    });
  </script>
</body>
</html>
