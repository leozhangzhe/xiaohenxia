## -*- coding: utf-8 -*-
<%include file="HEADER.tmpl"/>
<%
  if status == "FINISHED":
    statusy = "finished"
    statustext = "已完成"
  elif status.startswith("ABORT"):
    statusy = "aborted"
    statustext = "已中止"
  elif status == "CREATED" or status == "RUNNING" or status == "STARTED" or status == "STARTING" or status == "INITIALIZING":
    statusy = "running"
    statustext = "进行中"
  elif status == "ERROR-FAILED":
    statusy = "error"
    statustext = "失败"
  else:
    statusy = "queued"
    statustext = status
  end
%>

<div class="pg-fade-in">
  <!-- 扫描详情头部 -->
  <div class="pg-scan-detail-header">
    <div>
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
        <a href="${docroot}/" class="pg-btn pg-btn-ghost pg-btn-sm" style="padding:5px 8px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="15 18 9 12 15 6"/></svg>
        </a>
        <h1 class="pg-scan-name">${name}</h1>
        <span class='pg-badge pg-badge-${statusy}' id='scanstatusbadge'>
          % if statusy == "running":
          <span class="pg-scan-pulse" style="width:8px;height:8px;"></span>
          % endif
          ${statustext}
        </span>
        <span class="pg-loader" id="loader" style="display:none;"></span>
      </div>
      <div class="pg-scan-meta">
        <div class="pg-scan-meta-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          扫描ID：<code class="pg-code">${id}</code>
        </div>
      </div>
    </div>

    <div class="pg-detail-actions">
      <!-- 搜索框 -->
      <div class="pg-search-box">
        <svg class="pg-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input class='pg-input' id='searchvalue' type='text' placeholder='搜索结果...' style="width:240px;">
        <button class='pg-btn pg-btn-primary pg-btn-sm' id='searchbutton' type='button' style="position:absolute;right:4px;top:50%;transform:translateY(-50%);" onClick="searchDirector('${id}')">
          搜索
        </button>
      </div>

      <button id='btn-refresh' class="pg-btn pg-btn-ghost pg-btn-sm" onClick='refresh()' data-tooltip="刷新数据">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.58"/></svg>
        刷新
      </button>

      <!-- 导出下拉 -->
      <div class="pg-dropdown">
        <button class="pg-btn pg-btn-ghost pg-btn-sm" onclick="this.nextElementSibling.classList.toggle('show')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          导出数据
        </button>
        <div class="pg-dropdown-menu">
          <a class="pg-dropdown-item" href='#' onClick="exportEventData('${id}', currentType, 'csv')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            导出 CSV
          </a>
          <a class="pg-dropdown-item" href='#' onClick="exportEventData('${id}', currentType, 'excel')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
            导出 Excel
          </a>
        </div>
      </div>

      <button class='pg-btn pg-btn-ghost pg-btn-sm' id='btn-download-logs' onClick='downloadLogs("${id}")' data-tooltip="下载日志">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/></svg>
        日志
      </button>

      <!-- 假阳性标记 -->
      <div class="pg-dropdown">
        <button class='pg-btn pg-btn-ghost pg-btn-sm' onclick="this.nextElementSibling.classList.toggle('show')" id='btn-setfp' data-tooltip="标记误报">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
          误报标记
        </button>
        <div class="pg-dropdown-menu">
          <a href='#' class='pg-dropdown-item' onClick='setFp(1)'>标记为误报</a>
          <a href='#' class='pg-dropdown-item' onClick='setFp(0)'>取消误报标记</a>
        </div>
      </div>
    </div>
  </div>

  <div class="pg-card" style="margin-bottom:16px;">
    <div class="pg-card-header"><div class="pg-card-title">统一结果</div></div>
    <div class="pg-card-body">
      <p class="pg-hint-text">数据源：SpiderFoot 已保存扫描结果。仅显示本次启用模块已保存的事件，覆盖范围有限；结果可能存在误报，需人工核验。</p>
      <div id="normalized-scan-results" role="status">正在读取已保存结果...</div>
    </div>
  </div>

  <!-- 主视图切换 Tabs -->
  <div class="pg-scan-tabs">
    <button id='btn-status' class="pg-btn pg-btn-primary pg-btn-sm" onClick='scanSummaryView("${id}")'>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M9 19v-6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2zm0 0V9a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v10m-6 0a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2m0 0V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2z"/></svg>
      扫描概览
    </button>
    <button id='btn-correlations' class="pg-btn pg-btn-ghost pg-btn-sm" onClick='browseCorrelations("${id}")'>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      风险关联分析
    </button>
    <button id='btn-browse' class="pg-btn pg-btn-ghost pg-btn-sm" onClick='browseEventList("${id}")'>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
      数据浏览
    </button>
    <button id='btn-graph' class="pg-btn pg-btn-ghost pg-btn-sm" onClick='graphEvents("${id}")'>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="5" cy="5" r="3"/><circle cx="19" cy="5" r="3"/><circle cx="12" cy="19" r="3"/><line x1="7.5" y1="6.5" x2="10" y2="17"/><line x1="16.5" y1="6.5" x2="14" y2="17"/></svg>
      关联图谱
    </button>
    <button id='btn-info' class="pg-btn pg-btn-ghost pg-btn-sm" onClick='viewScanConfig("${id}")'>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      扫描配置
    </button>
    <button id='btn-log' class="pg-btn pg-btn-ghost pg-btn-sm" onClick='viewScanLog("${id}")'>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
      运行日志
    </button>

    <!-- 视图切换 -->
    <div style="margin-left:auto;display:flex;gap:6px;" id='customtabview'>
      <button id='btn-fullview' class="pg-btn pg-btn-ghost pg-btn-sm" onClick='browseUpdate("full")' data-tooltip="完整数据视图">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      </button>
      <button id='btn-uniqueview' class="pg-btn pg-btn-ghost pg-btn-sm" onClick='browseUpdate("unique")' data-tooltip="去重数据视图">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>

      <!-- 可视化下拉 -->
      <div class="pg-dropdown" id='customvizview' style="display:none;">
        <button class="pg-btn pg-btn-ghost pg-btn-sm" onclick="this.nextElementSibling.classList.toggle('show')" data-tooltip="可视化图谱">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="5" cy="5" r="3"/><circle cx="19" cy="5" r="3"/><circle cx="12" cy="19" r="3"/><line x1="7.5" y1="6.5" x2="10" y2="17"/><line x1="16.5" y1="6.5" x2="14" y2="17"/></svg>
          图谱
        </button>
        <div class="pg-dropdown-menu">
          <a class='pg-dropdown-item' onClick='browseUpdate("viz-bubble-data")'>气泡图（数据元素）</a>
          <a class='pg-dropdown-item' onClick='browseUpdate("viz-bubble-source")'>气泡图（来源数据）</a>
          <a class='pg-dropdown-item' onClick='browseUpdate("viz-dendro")'>发现路径树</a>
        </div>
      </div>

      <div class="pg-dropdown" id='customvizview2' style="display:none;">
        <button class="pg-btn pg-btn-ghost pg-btn-sm" onclick="this.nextElementSibling.classList.toggle('show')" data-tooltip="布局">
          布局
        </button>
        <div class="pg-dropdown-menu">
          <a class='pg-dropdown-item' onClick='vizUpdate("random")'>随机布局</a>
          <a class='pg-dropdown-item' onClick='vizUpdate("force")'>力导向布局</a>
          <a class='pg-dropdown-item' onClick='vizUpdate("download")'>保存图片</a>
        </div>
      </div>
    </div>
  </div>

  <!-- 主内容区 (由原版 JS 填充) -->
  <div id="scanresults-content" class="pg-card">
    <div class="pg-card-body">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;padding:20px;">
        <div class="pg-card" style="grid-column:1/-1;">
          <div style="display:flex;align-items:center;justify-content:space-between;">
            <div>
              <div style="font-size:13px;color:var(--text-muted);margin-bottom:4px;">扫描状态</div>
              <span class="pg-badge pg-badge-${statusy}">${statustext}</span>
            </div>
            <div style="text-align:right;">
              <div style="font-size:11px;color:var(--text-muted);">开始时间：${(summary or {}).get('started', '-')}</div>
              <div style="font-size:11px;color:var(--text-muted);">结束时间：${(summary or {}).get('ended', '-')}</div>
            </div>
          </div>
        </div>
        <div class="pg-card">
          <div class="pg-card-header"><div class="pg-card-title">风险概览</div></div>
          <div class="pg-card-body">
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:12px;text-align:center;">
              <div><div style="font-size:22px;font-weight:700;color:#e74c3c;">${(summary or {}).get('risks', {}).get('HIGH', 0)}</div><div style="font-size:11px;color:#e74c3c;">高风险</div></div>
              <div><div style="font-size:22px;font-weight:700;color:#f39c12;">${(summary or {}).get('risks', {}).get('MEDIUM', 0)}</div><div style="font-size:11px;color:#f39c12;">中风险</div></div>
              <div><div style="font-size:22px;font-weight:700;color:#3498db;">${(summary or {}).get('risks', {}).get('LOW', 0)}</div><div style="font-size:11px;color:#3498db;">低风险</div></div>
              <div><div style="font-size:22px;font-weight:700;color:#95a5a6;">${(summary or {}).get('risks', {}).get('INFO', 0)}</div><div style="font-size:11px;color:#95a5a6;">信息项</div></div>
            </div>
          </div>
        </div>
        <div class="pg-card">
          <div class="pg-card-header"><div class="pg-card-title">评估说明</div></div>
          <div class="pg-card-body" style="text-align:center;">
            <div style="font-size:18px;font-weight:700;">未提供安全评分</div>
            <div style="font-size:12px;color:var(--text-muted);">事件与关联风险需人工核验；无结果不等于安全。</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>var docroot = '${docroot}';</script>
<script src="${docroot}/static/node_modules/sigma/build/sigma.min.js"></script>
<script src="${docroot}/static/node_modules/sigma/build/plugins/sigma.parsers.json.min.js"></script>
<script src="${docroot}/static/node_modules/sigma/build/plugins/sigma.plugins.dragNodes.min.js"></script>
<script src="${docroot}/static/node_modules/sigma/build/plugins/sigma.layout.forceAtlas2.min.js"></script>
<script src="${docroot}/static/node_modules/sigma/build/plugins/sigma.renderers.snapshot.min.js"></script>
<script src="${docroot}/static/js/spiderfoot.scaninfo.js?v=${version}-stage3-fix"></script>
<script src="${docroot}/static/js/spiderfoot.resultview.js?v=${version}-stage3-fix"></script>
<script type='text/javascript'>
    var currentType = "ALL";
    var currentSection = "btn-status";
    var refresh = function() { browseEventList("${id}"); };

    // 设置当前 scanId（供 spiderfoot.scaninfo.js 使用）
    window.currentScanId = "${id}";

    $('#searchvalue').keyup(function(event) {
        if (event.keyCode == 13) { $('#searchbutton').click(); }
    });

    function switchSelectAll() {
        if (!$("#checkall")[0].checked) {
            $("input[id*=cb_]").prop('checked', false);
        } else {
            $("input[id*=cb_]").prop('checked', true);
        }
    }

    function getSelected() {
        var ids = [];
        $("input[id*=cb_]").each(function(i, obj) {
            if (obj.checked) ids[ids.length] = obj.id.replace("cb_", "");
        });
        return ids;
    }

    function setFp(flag) {
        var sel = getSelected();
        if (sel.length === 0) { alertify.error("请先选择至少一条记录"); return false; }
        var data = JSON.stringify(sel);
        $("#loader").show();
        $.ajax({ type: 'POST', url: docroot + '/resultsetfp', dataType: 'json',
                 data: {'id': '${id}', 'fp': flag, 'resultids': data} })
          .done(function(ret) {
              if (Array.isArray(ret) && ret[0] === 'SUCCESS' && ret[1] && ret[1].updated > 0) {
                  refresh();
                  loadNormalizedScanResults("${id}");
                  alertify.success('误报状态已保存');
              } else {
                  alertify.error('误报状态未更新，请刷新后重试。');
              }
          })
          .fail(function(xhr) {
              if (xhr.status !== 403 || xhr.getResponseHeader('X-CSRF-Error') !== '1') {
                  alertify.error('误报状态未更新，请刷新后重试。');
              }
          })
          .always(function() { $("#loader").hide(); });
    }

    // 自动加载扫描概览
    $(document).ready(function() {
        scanSummaryView("${id}");
        loadNormalizedScanResults("${id}");
    });
</script>

<%include file="FOOTER.tmpl"/>
