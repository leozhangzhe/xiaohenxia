    <script>
    (function() {
      var docroot = '${docroot}';
      function updateSidebarStatus() {
        fetch(docroot + '/scanlist').then(function(r) { return r.json(); }).then(function(data) {
          var running = 0, finished = 0;
          for (var i = 0; i < data.length; i++) {
            var s = data[i][6];
            if (['RUNNING','STARTING','STARTED','INITIALIZING'].indexOf(s) >= 0) running++;
            else if (s === 'FINISHED') finished++;
          }
          var dot = document.getElementById('sb-dot-scan');
          var status = document.getElementById('sb-status-scan');
          if (dot && status) {
            if (running > 0) {
              dot.className = 'pg-status-dot pg-dot-yellow';
              status.textContent = running + ' 进行中';
            } else {
              dot.className = 'pg-status-dot pg-dot-green';
              status.textContent = finished + ' 已完成';
            }
          }
          // 更新风险告警
          fetch(docroot + '/riskalerts').then(function(r) {
            if (!r.ok) throw new Error('not ok');
            return r.json();
          }).then(function(alerts) {
            // 过滤已关闭（dismissed）的告警
            var dismissed = [];
            try { dismissed = JSON.parse(localStorage.getItem('sf_dismissed_alerts') || '[]'); } catch(e) {}
            var activeAlerts = alerts.filter(function(a) { return dismissed.indexOf(a.alertId) < 0; });

            var high   = activeAlerts.filter(function(a) { return a.risk === 'HIGH'; }).length;
            var medium = activeAlerts.filter(function(a) { return a.risk === 'MEDIUM'; }).length;

            var dot = document.getElementById('sb-dot-risk');
            var status = document.getElementById('sb-status-risk');
            if (dot && status) {
              if (high > 0) {
                dot.className = 'pg-status-dot pg-dot-red';
                status.textContent = high + ' 高风险';
              } else {
                dot.className = 'pg-status-dot pg-dot-green';
                status.textContent = '当前未发现告警（覆盖有限）';
                status.title = '仅基于 SpiderFoot 已保存扫描结果；无告警不代表安全。';
              }
            }

            var scoreEl = document.getElementById('privacy-score');
            if (scoreEl) {
              scoreEl.textContent = '--';
              scoreEl.title = 'SpiderFoot 已保存结果覆盖有限，不提供综合安全评分。';
            }

            // 更新侧边栏告警徽章（只计未关闭的）
            var alertBadge = document.getElementById('nav-alert-badge');
            if (alertBadge) {
              if (activeAlerts.length > 0) {
                alertBadge.textContent = activeAlerts.length > 99 ? '99+' : activeAlerts.length;
                alertBadge.style.display = 'inline-block';
              } else {
                alertBadge.style.display = 'none';
              }
            }
          }).catch(function() {
            // 请求失败（未登录/网络错误）保持 -- 不修改
          });
        }).catch(function() {});
      }
      updateSidebarStatus();
      // 每 30 秒刷新一次状态
      setInterval(updateSidebarStatus, 30000);
    })();
    </script>

