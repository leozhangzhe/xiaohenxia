<%include file="HEADER.tmpl"/>

<div class="pg-page-header pg-fade-in">
  <h1 class="pg-page-title">扫描任务</h1>
  <p class="pg-page-subtitle">管理所有数字痕迹扫描任务，实时追踪扫描进度与结果</p>
</div>

% if newscan:
<div class="pg-alert pg-alert-success pg-fade-in" id="pg-newscan-banner">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
  <div>扫描 <strong>${newscan}</strong> 已成功发起，正在实时更新列表...</div>
</div>
% endif

% if rerunscans:
<div class="pg-alert pg-alert-success pg-fade-in">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
  <div>已成功重新发起多个扫描实例，请刷新查看最新状态。</div>
</div>
% endif

% if stoppedscan and len(errors) == 0:
<div class="pg-alert pg-alert-warning pg-fade-in">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
  <div>扫描已中止，请等待一两分钟让扫描完全停止。</div>
</div>
% endif

% if stoppedscan and len(errors) > 0:
<div class="pg-alert pg-alert-warning pg-fade-in">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
  <div>部分或全部扫描无法中止：
    <ul style="margin:6px 0 0 16px; padding:0;">
      % for err in errors:
      <li>${err}</li>
      % endfor
    </ul>
  </div>
</div>
% endif

<!-- 统计概览（可点击筛选） -->
<div class="pg-stats-grid pg-fade-in" id="scan-stats">
  <div class="pg-stat-card blue pg-stat-filter active" id="statcard-all" onclick="filter('all')" style="cursor:pointer;" title="点击筛选全部">
    <div class="pg-stat-icon blue">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </div>
    <div class="pg-stat-value" id="stat-total">${(scan_stats or {}).get('total', '--')}</div>
    <div class="pg-stat-label">全部扫描</div>
    <div class="pg-stat-hint">点击查看全部</div>
  </div>
  <div class="pg-stat-card green pg-stat-filter" id="statcard-finished" onclick="filter('finished')" style="cursor:pointer;" title="点击筛选已完成">
    <div class="pg-stat-icon green">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <div class="pg-stat-value" id="stat-finished">${(scan_stats or {}).get('finished', '--')}</div>
    <div class="pg-stat-label">已完成</div>
    <div class="pg-stat-hint">点击筛选</div>
  </div>
  <div class="pg-stat-card yellow pg-stat-filter" id="statcard-running" onclick="filter('running')" style="cursor:pointer;" title="点击筛选进行中">
    <div class="pg-stat-icon yellow">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <div class="pg-stat-value" id="stat-running">${(scan_stats or {}).get('running', '--')}</div>
    <div class="pg-stat-label">进行中</div>
    <div class="pg-stat-hint">点击筛选</div>
  </div>
  <div class="pg-stat-card red pg-stat-filter" id="statcard-error" onclick="filter('failed')" style="cursor:pointer;" title="点击筛选失败/中止">
    <div class="pg-stat-icon red">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    </div>
    <div class="pg-stat-value" id="stat-error">${(scan_stats or {}).get('failed', '--')}</div>
    <div class="pg-stat-label">失败/中止</div>
    <div class="pg-stat-hint">点击筛选</div>
  </div>
</div>

<!-- 操作栏 + 扫描列表 -->
<div class="pg-card pg-fade-in">
  <div class="pg-card-header">
    <div class="pg-card-title">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
      扫描任务列表
      <span class="pg-loader" id="scan-list-loader" style="display:none;"></span>
    </div>
    <div class="pg-card-actions">
      <div class="pg-search-box">
        <svg class="pg-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" class="pg-input" id="scan-search" placeholder="搜索扫描名称或目标..." style="padding-left:36px;">
      </div>
      <button class="pg-btn pg-btn-ghost pg-btn-sm" id="btn-rerun-selected">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.58"/></svg>
        重新扫描
      </button>
      <button class="pg-btn pg-btn-ghost pg-btn-sm" id="btn-stop-selected" style="color: var(--accent-yellow)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
        暂停选中
      </button>
      <button class="pg-btn pg-btn-ghost pg-btn-sm" id="btn-delete-selected" style="color: var(--accent-red)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
        删除选中
      </button>
      <a href="${docroot}/newscan" class="pg-btn pg-btn-primary pg-btn-sm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
        新建扫描
      </a>
    </div>
  </div>

  <div class="pg-card-body" style="padding: 0;">
    <div id="scancontent">
      <div class="pg-table-wrap">
        <table class="pg-table" id="scanlist-table">
          <thead>
            <tr>
              <th style="width:40px;"><input type="checkbox" id="select-all-scans" style="accent-color: var(--accent-blue);"></th>
              <th>扫描名称</th>
              <th>检测目标</th>
              <th>发现数据</th>
              <th>状态</th>
              <th>开始时间</th>
              <th>完成时间</th>
              <th style="width:140px;">操作</th>
            </tr>
          </thead>
          <tbody id="scanlist-tbody">
          % for row in (scan_rows or []):
            <tr>
              <td><input type="checkbox" id="cb_${row['id']}" style="accent-color: var(--accent-blue);"></td>
              <td><a href="${docroot}/scaninfo?id=${row['id']}" style="color:var(--accent-blue);text-decoration:none;font-weight:500;">${row['name'] | h}</a></td>
              <td><code style="font-size:11px;background:rgba(255,255,255,0.05);padding:2px 6px;border-radius:4px;">${row['target'] | h}</code></td>
              <td class="text-center"><span style="font-weight:600;color:var(--accent-cyan);">${row['element_count']}</span></td>
              <td class="text-center"><span class="pg-badge pg-badge-queued">${row['status'] | h}</span></td>
              <td style="font-size:11px;color:var(--text-secondary);white-space:nowrap;">${row['started'] | h}</td>
              <td style="font-size:11px;color:var(--text-secondary);white-space:nowrap;">${row['finished'] | h}</td>
              <td></td>
            </tr>
          % endfor
          </tbody>
        </table>
      </div>
      <!-- 空状态（渲染时动态显示/隐藏） -->
      <div class="pg-empty" id="pg-list-empty" style="display:none;">
        <div class="pg-empty-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="32" height="32"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </div>
        <div class="pg-empty-title" id="pg-empty-title">暂无扫描记录</div>
        <div class="pg-empty-desc" id="pg-empty-desc">点击右上角"新建扫描"开始您的第一次数字痕迹检测</div>
      </div>
    </div>
  </div>
</div>

<iframe class='hidden' id='exportframe'></iframe>

<script>var docroot = '${docroot}';</script>
<script type='text/javascript' src="${docroot}/static/js/spiderfoot.scanlist.js?v=${version}-stage3-gaps"></script>
<script type='text/javascript' src="${docroot}/static/js/privacyguard.scanlist.js?v=${version}"></script>
<script>
  // 页面加载时自动获取扫描列表（spiderfoot.scanlist.js 中已有 $(document).ready，
  // 这里作为双保险确保 showlist 被调用）
  if (typeof window.showlist === 'function') {
    $(document).ready(function() { window.showlist(); });
  } else {
    console.error('[SpiderFoot] showlist() not available when scanlist.tmpl loaded');
  }
</script>

<%include file="FOOTER.tmpl"/>
