<%include file="HEADER.tmpl"/>
<div class="fl-breadcrumb">我的工作区 <span>/</span> 申请记录与人工跟进</div>
<div class="fl-page-heading"><div><h1>申请记录与人工跟进</h1><p>管理本人的申请、核对目标与查看人工备注。</p></div></div>
<div class="fl-notice warning fl-request-intro">这不是自动删除；不保证第三方平台执行；需要人工跟进或用户自行联系平台。创建记录不会向平台提交申请。</div>
<div class="pa-stats-row" id="statsRow"><div class="pa-stat-item"><div class="pa-stat-num" id="stat-mask">${stats.get('mask', {}).get('done', 0)}</div><div class="pa-stat-label">本地脱敏完成</div></div><div class="pa-stat-item"><div class="pa-stat-num" id="stat-hide">${sum(stats.get('hide', {}).values())}</div><div class="pa-stat-label">隐藏申请记录</div></div><div class="pa-stat-item"><div class="pa-stat-num" id="stat-delete">${sum(stats.get('delete', {}).values())}</div><div class="pa-stat-label">删除申请记录</div></div><div class="pa-stat-item"><div class="pa-stat-num" id="stat-total">${stats.get('total', 0)}</div><div class="pa-stat-label">记录总数</div></div></div>
<div class="fl-request-grid"><div class="fl-request-main">
<div class="fl-action-tabs" role="group" aria-label="选择处理方式"><button type="button" class="pa-action-card selected" data-action="delete" onclick="selectAction('delete')">删除申请记录</button><button type="button" class="pa-action-card" data-action="hide" onclick="selectAction('hide')">隐藏申请记录</button><button type="button" class="pa-action-card" data-action="mask" onclick="selectAction('mask')">本地文本脱敏</button></div>
<section class="pa-form-panel visible" id="actionForm"><div class="pa-form-header"><div id="formIconWrap"></div><h2 class="pa-form-header-title" id="formTitle">填写删除申请信息</h2></div>
<div class="pa-form-row"><label for="pa-platform">目标平台 / 内容来源</label><input class="pg-input" id="pa-platform" type="text" maxlength="128" placeholder="填写目标平台或内容来源" autocomplete="off"></div>
<div class="pa-form-row"><label for="pa-content" id="contentLabel">申请目标与说明 / 待脱敏文本</label><textarea class="pg-input" id="pa-content" rows="4" maxlength="10000" placeholder="填写相关链接和说明，或粘贴需要在本地脱敏的文本"></textarea><div class="fl-small fl-muted" id="contentHint">删除申请：填写目标和说明，保存为申请记录并等待人工跟进</div></div>
<label id="pa-confirm-row" class="fl-small"><input type="checkbox" id="pa-confirm"> 我确认只创建申请记录，尚未联系第三方平台；后续需要人工跟进或自行联系平台。</label>
<div class="fl-form-actions"><button class="pg-btn pg-btn-primary" type="button" id="submitBtn" onclick="submitAction()"><span id="submitBtnText">保存记录</span></button><button class="pg-btn" type="button" onclick="cancelAction()">取消</button><div class="pg-spinner" id="submitSpinner" style="display:none;width:20px;height:20px"></div></div><div class="pa-result-box" id="resultBox" role="status" aria-live="polite"></div></section>
<section class="pg-card"><div class="pg-card-header"><h2 class="pg-card-title">我的申请记录</h2><button class="pg-btn pg-btn-sm" type="button" onclick="loadList()">刷新</button></div><div class="pg-card-body" style="padding:0">
<div id="listLoading" class="fl-empty" style="display:none">正在读取申请记录…</div><div id="listEmpty" class="fl-empty" style="display:none">暂无申请记录</div><div id="listWrap" class="pa-bounded-list" role="region" aria-label="申请记录表格，可滚动" tabindex="0" style="display:none"><table class="pa-list-table"><thead><tr><th>类型</th><th>平台 / 来源</th><th>内容摘要</th><th>状态</th><th>用户确认 / 备注</th><th>创建 / 更新时间</th><th>操作</th></tr></thead><tbody id="listBody"></tbody></table></div><div id="listPager" class="pa-request-pager" role="navigation" aria-label="我的申请记录分页"></div></div></section>
% if is_admin:
<section class="pg-card" style="margin-top:22px" id="adminFollowupPanel"><div class="pg-card-header"><h2 class="pg-card-title">管理员人工跟进</h2><button class="pg-btn pg-btn-sm" type="button" onclick="loadAdminRequests()">刷新</button></div><div class="pg-card-body"><p class="fl-small fl-muted">点击一条申请展开处理。状态由管理员依据人工记录更新；“已联系平台”需有实际联系依据。</p><div id="adminRequestList" class="pa-followup-list pa-bounded-list">正在读取…</div><div id="adminRequestPager" class="pa-request-pager" role="navigation" aria-label="管理员人工跟进分页"></div></div></section>
% endif
</div><aside class="fl-stack"><section class="fl-panel"><div class="fl-panel-head"><h2>人工跟进流程</h2></div><div class="fl-panel-body"><ol class="fl-timeline"><li><strong>确认并记录</strong><p>核对目标、申请类型与用户确认。</p></li><li><strong>人工核实与联系</strong><p>由人工确认可行渠道，有依据后记录联系情况。</p></li><li><strong>追踪平台反馈</strong><p>不承诺处理时限或执行结果。</p></li></ol><div class="fl-flow-states"><span>草稿</span><span>已记录</span><span>待人工处理</span><span>已联系平台</span><span>平台处理中</span><span>已完成</span><span>无法处理</span></div></div></section><div class="fl-notice">普通用户只能查看自己的申请。人工备注和处理状态由管理员更新。</div><div class="fl-notice">本地脱敏仅处理填写的文本，不修改第三方网站上的内容。脱敏结果仍需要人工复核。</div></aside></div>
<script>
var docroot = '${docroot}';
var currentAction = 'delete';
var currentPage = 1;
var totalRecords = 0;
var requestPageSize = 5, adminPageSize = 5, adminPage = 1;
var ownListSequence = 0, adminListSequence = 0, adminOpenId = null;

// ── 选择操作类型 ──
function selectAction(type) {
  // 清除之前选中
  document.querySelectorAll('.pa-action-card').forEach(function(c) {
    c.classList.remove('selected');
  });
  document.querySelectorAll('.pa-action-card[data-action="' + type + '"]').forEach(function(c) {
    c.classList.add('selected');
  });

  currentAction = type;
  var form = document.getElementById('actionForm');
  form.classList.add('visible');

  // 更新表单头
  var icons = {
    mask:   '<svg viewBox="0 0 24 24" fill="none" stroke="var(--accent-blue)" stroke-width="2" width="20" height="20"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>',
    hide:   '<svg viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" width="20" height="20"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>',
    delete: '<svg viewBox="0 0 24 24" fill="none" stroke="var(--accent-red)" stroke-width="2" width="20" height="20"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>',
  };
  var titles = { mask: '填写脱敏处理信息', hide: '填写隐藏申请信息', delete: '填写删除申请信息' };
  var hints = {
    mask:   '脱敏处理：粘贴完整文本，系统将对手机号、邮箱、地址等字段自动打码',
    hide:   '隐藏申请：填写目标和说明，保存为申请记录并等待人工跟进',
    delete: '删除申请：填写目标和说明，保存为申请记录并等待人工跟进',
  };
  document.getElementById('formIconWrap').innerHTML = icons[type] || '';
  document.getElementById('formTitle').textContent = titles[type] || '';
  document.getElementById('contentHint').textContent = hints[type] || '';
  document.getElementById('pa-confirm-row').style.display = type === 'mask' ? 'none' : 'block';
  document.getElementById('pa-confirm').checked = false;

  // 清空表单
  document.getElementById('pa-platform').value = '';
  document.getElementById('pa-content').value = '';
  document.getElementById('resultBox').style.display = 'none';
  document.getElementById('resultBox').textContent = '';
  document.getElementById('resultBox').className = 'pa-result-box';

  form.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function cancelAction() {
  currentAction = null;
  document.querySelectorAll('.pa-action-card').forEach(function(c) {
    c.classList.remove('selected');
  });
  document.getElementById('actionForm').classList.remove('visible');
}

// ── 提交处理任务 ──
function submitAction() {
  if (!currentAction) return;
  var platform = document.getElementById('pa-platform').value.trim();
  var content  = document.getElementById('pa-content').value.trim();

  if (!platform) { showMsg('请填写目标平台或内容来源', true); return; }
  if (!content)  { showMsg('请填写需要处理的内容', true); return; }
  if (currentAction !== 'mask' && !document.getElementById('pa-confirm').checked) {
    showMsg('请先确认申请记录与人工跟进说明', true); return;
  }

  document.getElementById('submitBtn').disabled = true;
  document.getElementById('submitSpinner').style.display = 'inline-block';
  document.getElementById('resultBox').style.display = 'none';

  var fd = new FormData();
  fd.append('action_type', currentAction);
  fd.append('platform', platform);
  fd.append('content', content);
  if (currentAction !== 'mask') fd.append('user_confirmed', '1');

  fetch(docroot + '/privacyactionsubmit', { method: 'POST', body: fd })
    .then(function(r) { if (!r.ok) throw new Error(r.status === 403 ? '安全令牌或权限无效，请刷新页面后重试。' : '服务暂不可用，请稍后重试。'); return r.json(); })
    .then(function(data) {
      document.getElementById('submitBtn').disabled = false;
      document.getElementById('submitSpinner').style.display = 'none';

      if (!data.success) {
        showMsg('提交失败：' + (data.error || '未知错误'), true);
        return;
      }

      var msgs = {
        mask:   '脱敏处理完成。\n\n处理结果：\n',
        hide:   '申请已记录，等待人工跟进；尚未联系平台。\n\n记录ID：',
        delete: '申请已记录，等待人工跟进；尚未联系平台。\n\n记录ID：',
      };

      var msg = msgs[currentAction] || '记录已保存\n\n任务ID：';
      if (currentAction === 'mask' && data.masked_content) {
        msg += data.masked_content;
      } else {
        msg += data.id;
      }
      msg += '\n备注：' + (data.note || '');

      showMsg(msg, false);
      loadList(1); loadAdminRequests();
      // 刷新统计
      updateStats(currentAction, data.status);
    })
    .catch(function(error) {
      document.getElementById('submitBtn').disabled = false;
      document.getElementById('submitSpinner').style.display = 'none';
      showMsg(error.message || '保存失败，请稍后重试', true);
    });
}

function showMsg(text, isError) {
  var box = document.getElementById('resultBox');
  box.textContent = text;
  box.className = 'pa-result-box' + (isError ? ' error' : '');
  box.style.display = 'block';
}

// ── 加载任务列表 ──
function loadList(page) {
  page = page || currentPage;
  currentPage = page;
  var sequence = ++ownListSequence;

  document.getElementById('listLoading').style.display = 'block';
  document.getElementById('listEmpty').style.display = 'none';
  document.getElementById('listWrap').style.display = 'none';
  document.getElementById('listPager').replaceChildren();
  document.getElementById('listEmpty').textContent = '暂无申请记录';

  fetch(docroot + '/privacyactionlist?page=' + page + '&page_size=' + requestPageSize)
    .then(function(r) { if (!r.ok) throw new Error(r.status === 403 ? '安全令牌或权限无效，请刷新页面后重试。' : '服务暂不可用，请稍后重试。'); return r.json(); })
    .then(function(data) {
      if (sequence !== ownListSequence) return;
      document.getElementById('listLoading').style.display = 'none';

      if (!data.success) {
        document.getElementById('listEmpty').textContent = '申请记录暂时无法读取。';
        document.getElementById('listEmpty').style.display = 'block';
        return;
      }
      totalRecords = data.total || 0;
      var last = Math.max(1, Math.ceil(totalRecords / requestPageSize));
      if (page > last) { loadList(last); return; }
      renderPager(totalRecords, page);
      document.getElementById('listBody').replaceChildren();
      if (!data.items || data.items.length === 0) {
        document.getElementById('listEmpty').style.display = 'block';
        return;
      }

      var tbody = document.getElementById('listBody');
      tbody.innerHTML = '';

      data.items.forEach(function(item) {
        var tr = document.createElement('tr');
        tr.innerHTML =
          '<td data-label="类型">' + typeTag(item.action_type) + '</td>' +
          '<td data-label="目标" style="max-width:130px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="' + escHtml(item.platform || '') + '">' + escHtml(item.platform || '-') + '</td>' +
          '<td data-label="内容" style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="' + escHtml(item.content_preview || '') + '">' + escHtml(item.content_preview || '-') + '</td>' +
          '<td data-label="状态">' + statusTag(item.status) + '</td>' +
          '<td data-label="确认 / 备注" style="max-width:160px; color: var(--text-muted); font-size:12px;">' + (item.user_confirmed ? '已确认 · ' : '未确认（旧记录） · ') + escHtml(item.manual_note || item.note || '-') + '</td>' +
          '<td data-label="创建 / 更新" style="font-size:12px; color:var(--text-muted); white-space:nowrap;">' + fmtTime(item.created_at) + '<br>' + fmtTime(item.updated_at) + '</td>' +
          '<td data-label="操作"><button class="pg-btn pg-btn-sm" style="color:var(--accent-red); border-color:rgba(239,68,68,.3);" onclick="deleteRecord(\'' + item.id + '\')">删除</button></td>';
        if (window.vaultMotion) window.vaultMotion.requestTrack(tr.querySelector('[data-label="状态"]'), item);
        tbody.appendChild(tr);
      });

      document.getElementById('listWrap').style.display = 'block';
      document.getElementById('listWrap').scrollTop = 0;
    })
    .catch(function() {
      if (sequence !== ownListSequence) return;
      document.getElementById('listLoading').style.display = 'none';
      document.getElementById('listEmpty').textContent = '申请记录暂时无法读取。';
      document.getElementById('listEmpty').style.display = 'block';
    });
}

function deleteRecord(id) {
  if (!confirm('确定删除这条处理记录吗？')) return;
  fetch(docroot + '/privacyactiondelete', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
    body: new URLSearchParams({ action_id: id })
  })
    .then(function(r) { if (!r.ok) throw new Error(r.status === 403 ? '安全令牌或权限无效，请刷新页面后重试。' : '服务暂不可用，请稍后重试。'); return r.json(); })
    .then(function(data) {
      if (data.success) {
        alertify.success('已删除');
        loadList(currentPage); loadAdminRequests();
      } else {
        alertify.error('删除失败：' + (data.error || '未知错误'));
      }
    }).catch(function(error) { alertify.error(error.message || '删除失败，请稍后重试'); });
}

// ── 渲染分页器 ──
function renderPager(total, page) {
  renderRequestPager('listPager', total, page, requestPageSize, loadList, function(size) {
    requestPageSize = size; loadList(1);
  });
}

function renderRequestPager(id, total, page, size, go, resize) {
  var pages = Math.max(1, Math.ceil(total / size));
  var pager = document.getElementById(id);
  if (!pager) return;
  pager.replaceChildren();
  var info = document.createElement('span');
  info.className = 'pa-page-info'; info.setAttribute('role', 'status');
  info.textContent = '共 ' + total + ' 条 / 第 ' + page + '/' + pages + ' 页';
  pager.appendChild(info);
  var controls = document.createElement('div'); controls.className = 'pa-page-controls';
  var sizes = document.createElement('select'); sizes.setAttribute('aria-label', id === 'listPager' ? '我的申请每页数量' : '管理员跟进每页数量');
  [5, 10, 20].forEach(function(n) { var option = document.createElement('option'); option.value = String(n); option.textContent = n + ' 条 / 页'; sizes.appendChild(option); });
  sizes.value = String(size); sizes.onchange = function() { resize(Number(this.value)); }; controls.appendChild(sizes);
  var prev = mkBtn('上一页', function() { go(page - 1); }); prev.disabled = page <= 1; controls.appendChild(prev);
  var label = document.createElement('label'); label.textContent = '页码';
  var jump = document.createElement('input'); jump.type = 'number'; jump.min = 1; jump.max = pages; jump.value = page; jump.inputMode = 'numeric';
  jump.setAttribute('aria-label', id === 'listPager' ? '我的申请跳转页码' : '管理员跟进跳转页码'); jump.disabled = pages <= 1;
  jump.onchange = function() { var n = Number(this.value); if (Number.isInteger(n) && n >= 1 && n <= pages) go(n); else this.value = page; };
  label.appendChild(jump); controls.appendChild(label);
  var next = mkBtn('下一页', function() { go(page + 1); }); next.disabled = page >= pages; controls.appendChild(next);
  pager.appendChild(controls);
}

function mkBtn(label, fn) {
  var btn = document.createElement('button');
  btn.type = 'button';
  btn.className = 'pg-btn pg-btn-sm';
  btn.textContent = label;
  btn.onclick = fn;
  return btn;
}

// ── 辅助函数 ──
function typeTag(t) {
  var map = {
    mask:   '<span class="pa-badge pa-badge-mask">脱敏</span>',
    hide:   '<span class="pa-badge pa-badge-hide">隐藏</span>',
    delete: '<span class="pa-badge pa-badge-delete">删除</span>',
  };
  return map[t] || escHtml(t);
}

function statusTag(s) {
  var map = {
    done: '<span class="pa-badge pa-badge-done">已完成（本地脱敏）</span>',
    draft: '<span class="pa-badge pa-badge-pending">草稿</span>',
    recorded: '<span class="pa-badge pa-badge-pending">已记录</span>',
    awaiting_manual: '<span class="pa-badge pa-badge-pending">待人工处理</span>',
    platform_contacted: '<span class="pa-badge pa-badge-processing">已联系平台</span>',
    platform_processing: '<span class="pa-badge pa-badge-processing">平台处理中</span>',
    completed: '<span class="pa-badge pa-badge-done">已完成</span>',
    unable: '<span class="pa-badge pa-badge-failed">无法处理</span>',
  };
  return map[s] || escHtml(s);
}

function fmtTime(ts) {
  if (!ts) return '-';
  var d = new Date(ts * 1000);
  return d.toLocaleDateString('zh-CN') + ' ' + d.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
}

function escHtml(s) {
  if (!s) return '';
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function updateStats(type, status) {
  // 简单：成功提交后给对应统计 +1（精确统计请刷新页面）
  var ids = { mask: 'stat-mask', hide: 'stat-hide', delete: 'stat-delete' };
  var el = document.getElementById(ids[type]);
  if (el) el.textContent = parseInt(el.textContent || '0', 10) + 1;
  var tot = document.getElementById('stat-total');
  if (tot) tot.textContent = parseInt(tot.textContent || '0', 10) + 1;
}

// 页面加载后自动加载列表
function loadAdminRequests(page) {
  var target = document.getElementById('adminRequestList');
  if (!target) return;
  page = page || adminPage; adminPage = page;
  var sequence = ++adminListSequence;
  target.textContent = '正在读取人工跟进记录…';
  document.getElementById('adminRequestPager').replaceChildren();
  fetch(docroot + '/privacyactionadminlist?page=' + page + '&page_size=' + adminPageSize)
    .then(function(r) { if (!r.ok) throw new Error('unavailable'); return r.json(); })
    .then(function(data) {
      if (sequence !== adminListSequence) return;
      if (!data.success || !Array.isArray(data.items)) throw new Error('unavailable');
      var last = Math.max(1, Math.ceil(data.total / adminPageSize));
      if (page > last) { loadAdminRequests(last); return; }
      target.replaceChildren(); target.scrollTop = 0;
      data.items.forEach(function(item) {
        var row = document.createElement('details'); row.className = 'pa-followup-row';
        var summary = document.createElement('summary'); summary.className = 'pa-followup-summary';
        var title = document.createElement('strong');
        title.textContent = (item.action_type === 'hide' ? '隐藏' : '删除') + ' · ' + item.platform;
        var badge = document.createElement('span'); badge.innerHTML = statusTag(item.status);
        var meta = document.createElement('small');
        meta.textContent = item.username + ' · 创建 ' + fmtTime(item.created_at) + ' · 点击展开处理';
        summary.appendChild(title); summary.appendChild(badge); summary.appendChild(meta); row.appendChild(summary);
        var editorBuilt = false;
        row.ontoggle = function() {
          if (!row.open && adminOpenId === item.id) adminOpenId = null;
          if (!row.open || editorBuilt) return;
          editorBuilt = true; adminOpenId = item.id;
          var editor = document.createElement('div'); editor.className = 'pa-followup-editor';
          var content = document.createElement('p'); content.className = 'pa-followup-content';
          content.textContent = item.content_preview + ' · 用户确认：' + (item.user_confirmed ? '已确认' : '未确认（旧记录）') +
            ' · 更新 ' + fmtTime(item.updated_at); editor.appendChild(content);
          var stateLabel = document.createElement('label'); stateLabel.textContent = '处理状态';
          var state = document.createElement('select'); state.setAttribute('aria-label', '处理状态：' + item.platform);
          var labels = {draft:'草稿',recorded:'已记录',awaiting_manual:'待人工处理',platform_contacted:'已联系平台',
            platform_processing:'平台处理中',completed:'已完成',unable:'无法处理'};
          Object.keys(labels).forEach(function(value) {
            var option = document.createElement('option'); option.value = value; option.textContent = labels[value]; state.appendChild(option);
          });
          state.value = item.status; stateLabel.appendChild(state); editor.appendChild(stateLabel);
          var noteLabel = document.createElement('label'); noteLabel.textContent = '人工备注 / 联系依据';
          var note = document.createElement('textarea'); note.className = 'pg-input'; note.rows = 3; note.maxLength = 1024;
          note.placeholder = '涉及平台状态时填写实际联系或处理依据'; note.value = item.manual_note || '';
          note.setAttribute('aria-label', '人工备注：' + item.platform); noteLabel.appendChild(note); editor.appendChild(noteLabel);
          var save = mkBtn('保存人工跟进', function() {
            save.disabled = true;
            fetch(docroot + '/privacyactionstatus', {
              method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},
              body: new URLSearchParams({action_id:item.id,status:state.value,manual_note:note.value})
            }).then(function(r) {
              if (!r.ok) {
                if (r.status === 400) return r.json().then(function(body) { throw new Error(body.error || '处理状态或备注无效。'); });
                throw new Error(r.status === 403 ? '安全令牌或权限无效，请刷新页面后重试。' : '服务暂不可用，请稍后重试。');
              }
              return r.json();
            }).then(function(result) {
              if (!result.success) throw new Error(result.error || '保存失败');
              alertify.success('人工跟进状态已保存'); loadList(currentPage); loadAdminRequests(adminPage);
            }).catch(function(error) { alertify.error(error.message || '保存失败'); })
              .finally(function() { save.disabled = false; });
          });
          editor.appendChild(save); row.appendChild(editor);
        };
        target.appendChild(row);
        if (adminOpenId === item.id) { row.open = true; row.ontoggle(); }
      });
      if (!data.items.length) target.textContent = '暂无待跟进申请';
      renderRequestPager('adminRequestPager', data.total, page, adminPageSize, loadAdminRequests, function(size) {
        adminPageSize = size; loadAdminRequests(1);
      });
    }).catch(function() {
      if (sequence === adminListSequence) target.textContent = '人工跟进记录暂时无法读取，请点击刷新重试。';
    });
}

document.addEventListener('DOMContentLoaded', function() { loadList(1); loadAdminRequests(); });
</script>


