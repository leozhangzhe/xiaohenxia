<%include file="HEADER.tmpl"/>

<style>
/* ── 三色操作卡片 ── */
.pa-action-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 24px;
}
@media (max-width: 900px) {
  .pa-action-grid { grid-template-columns: 1fr; }
}
.pa-action-card {
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 24px;
  cursor: pointer;
  transition: all .2s;
  position: relative;
  overflow: hidden;
}
.pa-action-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
}
.pa-action-card.mask::before  { background: var(--accent-blue); }
.pa-action-card.hide::before  { background: var(--accent-purple, #a78bfa); }
.pa-action-card.delete::before{ background: var(--accent-red); }
.pa-action-card:hover {
  border-color: transparent;
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(0,0,0,.15);
}
.pa-action-card.mask:hover  { border-color: var(--accent-blue); }
.pa-action-card.hide:hover  { border-color: var(--accent-purple, #a78bfa); }
.pa-action-card.delete:hover{ border-color: var(--accent-red); }
.pa-action-card.selected {
  border-color: transparent;
}
.pa-action-card.mask.selected  { border-color: var(--accent-blue);   background: rgba(59,130,246,.06); }
.pa-action-card.hide.selected  { border-color: #a78bfa; background: rgba(167,139,250,.06); }
.pa-action-card.delete.selected{ border-color: var(--accent-red);    background: rgba(239,68,68,.06); }

.pa-card-icon {
  width: 48px; height: 48px;
  border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 14px;
}
.mask  .pa-card-icon { background: rgba(59,130,246,.12); }
.hide  .pa-card-icon { background: rgba(167,139,250,.12); }
.delete.pa-card-icon,
.delete .pa-card-icon { background: rgba(239,68,68,.12); }

.pa-card-title { font-size: 16px; font-weight: 600; margin-bottom: 6px; }
.pa-card-desc  { font-size: 13px; color: var(--text-muted); line-height: 1.6; }
.pa-card-badge {
  display: inline-block;
  font-size: 11px; font-weight: 600;
  padding: 2px 8px; border-radius: 20px;
  margin-top: 10px;
}
.mask   .pa-card-badge { background: rgba(59,130,246,.15); color: var(--accent-blue); }
.hide   .pa-card-badge { background: rgba(167,139,250,.15); color: #a78bfa; }
.delete .pa-card-badge { background: rgba(239,68,68,.15);   color: var(--accent-red); }

/* ── 提交表单 ── */
.pa-form-panel {
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 24px;
  margin-bottom: 24px;
  display: none;
}
.pa-form-panel.visible { display: block; }
.pa-form-header {
  display: flex; align-items: center; gap: 10px;
  margin-bottom: 20px; padding-bottom: 14px;
  border-bottom: 1px solid var(--border-color);
}
.pa-form-header-title { font-size: 15px; font-weight: 600; }
.pa-form-row { margin-bottom: 16px; }
.pa-form-row label { display: block; font-size: 13px; font-weight: 500; margin-bottom: 6px; color: var(--text-secondary); }
.pa-result-box {
  background: rgba(16,185,129,.08);
  border: 1px solid rgba(16,185,129,.3);
  border-radius: 8px;
  padding: 14px 16px;
  margin-top: 12px;
  font-size: 13px;
  line-height: 1.7;
  display: none;
  white-space: pre-wrap;
  word-break: break-all;
}
.pa-result-box.error {
  background: rgba(239,68,68,.08);
  border-color: rgba(239,68,68,.3);
}

/* ── 任务列表 ── */
.pa-list-table { width: 100%; border-collapse: collapse; }
.pa-list-table th {
  text-align: left; padding: 10px 14px;
  font-size: 12px; font-weight: 600;
  color: var(--text-muted); text-transform: uppercase;
  background: var(--table-header-bg, rgba(0,0,0,.03));
  border-bottom: 1px solid var(--border-color);
}
.pa-list-table td {
  padding: 12px 14px;
  font-size: 13px;
  border-bottom: 1px solid var(--border-color);
  vertical-align: top;
}
.pa-list-table tr:last-child td { border-bottom: none; }
.pa-list-table tr:hover td { background: rgba(0,0,0,.02); }
.pa-badge { display: inline-block; padding: 2px 8px; border-radius: 20px; font-size: 11px; font-weight: 600; }
.pa-badge-mask    { background: rgba(59,130,246,.12); color: var(--accent-blue); }
.pa-badge-hide    { background: rgba(167,139,250,.12); color: #a78bfa; }
.pa-badge-delete  { background: rgba(239,68,68,.12);   color: var(--accent-red); }
.pa-badge-done    { background: rgba(16,185,129,.12); color: var(--accent-green); }
.pa-badge-processing { background: rgba(245,158,11,.12); color: var(--accent-yellow); }
.pa-badge-pending { background: rgba(156,163,175,.12); color: var(--text-muted); }
.pa-badge-failed  { background: rgba(239,68,68,.12);   color: var(--accent-red); }

/* ── 统计条 ── */
.pa-stats-row {
  display: flex; gap: 16px; flex-wrap: wrap;
  margin-bottom: 20px;
}
.pa-stat-item {
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  padding: 14px 20px;
  flex: 1; min-width: 110px;
  text-align: center;
}
.pa-stat-num  { font-size: 28px; font-weight: 700; }
.pa-stat-label{ font-size: 12px; color: var(--text-muted); margin-top: 4px; }
.color-blue   { color: var(--accent-blue); }
.color-purple { color: #a78bfa; }
.color-red    { color: var(--accent-red); }
.color-green  { color: var(--accent-green); }
</style>

<!-- ── 页面标题 ── -->
<div class="pg-page-header pg-fade-in">
  <h1 class="pg-page-title">痕迹清理与管控</h1>
  <p class="pg-page-subtitle">支持脱敏处理、隐藏申请、删除申请三种方式，全自动处理您的数字痕迹</p>
</div>

<!-- ── 统计概览 ── -->
<div class="pa-stats-row pg-fade-in" id="statsRow">
  <div class="pa-stat-item">
    <div class="pa-stat-num color-blue" id="stat-mask">${stats.get('mask', {}).get('done', 0)}</div>
    <div class="pa-stat-label">脱敏完成</div>
  </div>
  <div class="pa-stat-item">
    <div class="pa-stat-num color-purple" id="stat-hide">${stats.get('hide', {}).get('done', 0) + stats.get('hide', {}).get('processing', 0)}</div>
    <div class="pa-stat-label">隐藏处理中</div>
  </div>
  <div class="pa-stat-item">
    <div class="pa-stat-num color-red" id="stat-delete">${stats.get('delete', {}).get('done', 0) + stats.get('delete', {}).get('processing', 0)}</div>
    <div class="pa-stat-label">删除处理中</div>
  </div>
  <div class="pa-stat-item">
    <div class="pa-stat-num color-green" id="stat-total">${stats.get('total', 0)}</div>
    <div class="pa-stat-label">累计处理</div>
  </div>
</div>

<!-- ── 三类操作选择卡 ── -->
<div class="pa-action-grid pg-fade-in">

  <!-- 脱敏处理 -->
  <div class="pa-action-card mask" onclick="selectAction('mask')">
    <div class="pa-card-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent-blue)" stroke-width="2" width="24" height="24">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
    </div>
    <div class="pa-card-title">脱敏处理</div>
    <div class="pa-card-desc">对内容中的姓名、手机号、邮箱、地址、身份证号等关键敏感字段自动打码，保留内容结构，无法识别真实信息。适用于论坛留言、公开表单等无法直接删除的内容。</div>
    <span class="pa-card-badge">⚡ 立即完成</span>
  </div>

  <!-- 隐藏处理 -->
  <div class="pa-action-card hide" onclick="selectAction('hide')">
    <div class="pa-card-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" width="24" height="24">
        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
        <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
        <line x1="1" y1="1" x2="23" y2="23"/>
      </svg>
    </div>
    <div class="pa-card-title">隐藏处理</div>
    <div class="pa-card-desc">对不想删除但不希望被外人看到的数字痕迹，一键发起隐藏申请。处理完成后，内容不再对外公开可见，只有本人可以查看，完美兼顾留存需求与隐私保护。</div>
    <span class="pa-card-badge">🔒 申请处理中</span>
  </div>

  <!-- 删除申请 -->
  <div class="pa-action-card delete" onclick="selectAction('delete')">
    <div class="pa-card-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent-red)" stroke-width="2" width="24" height="24">
        <polyline points="3 6 5 6 21 6"/>
        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
        <line x1="10" y1="11" x2="10" y2="17"/>
        <line x1="14" y1="11" x2="14" y2="17"/>
      </svg>
    </div>
    <div class="pa-card-title">删除申请</div>
    <div class="pa-card-desc">对不需要留存、想彻底清除的数字痕迹，自动向对应平台提交删除请求，全程跟踪处理进度，及时反馈结果。真正做到"不留痕、不溯源、不扩散"。</div>
    <span class="pa-card-badge">🗑 自动跟踪进度</span>
  </div>

</div>

<!-- ── 提交表单（动态显示） ── -->
<div class="pa-form-panel pg-fade-in" id="actionForm">
  <div class="pa-form-header">
    <div id="formIconWrap"></div>
    <div class="pa-form-header-title" id="formTitle">填写处理信息</div>
  </div>

  <div class="pa-form-row">
    <label for="pa-platform">目标平台 / 内容来源</label>
    <input class="pg-input" id="pa-platform" type="text" placeholder="例：微博、知乎、某论坛帖子链接" autocomplete="off"/>
  </div>

  <div class="pa-form-row">
    <label for="pa-content" id="contentLabel">需要处理的内容</label>
    <textarea class="pg-input" id="pa-content" rows="5"
      placeholder="粘贴需要脱敏/隐藏/删除的具体内容文本，或填写相关链接"
      style="resize: vertical; font-family: inherit; line-height: 1.6;"></textarea>
    <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;" id="contentHint">
      脱敏处理：粘贴完整文本，系统将对手机号、邮箱、地址等字段自动打码
    </div>
  </div>

  <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
    <button class="pg-btn pg-btn-primary" id="submitBtn" onclick="submitAction()">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
        <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
      </svg>
      <span id="submitBtnText">提交处理</span>
    </button>
    <button class="pg-btn" onclick="cancelAction()" style="background: transparent; border: 1px solid var(--border-color);">
      取消
    </button>
    <div class="pg-spinner" id="submitSpinner" style="display: none; width: 20px; height: 20px;"></div>
  </div>

  <!-- 结果展示 -->
  <div class="pa-result-box" id="resultBox"></div>
</div>

<!-- ── 处理记录列表 ── -->
<div class="pg-card pg-fade-in">
  <div class="pg-card-header">
    <div class="pg-card-title">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
      </svg>
      处理记录
    </div>
    <div style="display: flex; gap: 8px; align-items: center;">
      <button class="pg-btn pg-btn-sm" onclick="loadList()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
          <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/>
        </svg>
        刷新
      </button>
    </div>
  </div>
  <div class="pg-card-body" style="padding: 0;">
    <div id="listLoading" style="text-align: center; padding: 40px; display: none;">
      <div class="pg-spinner" style="margin: 0 auto 12px;"></div>
      <p style="color: var(--text-muted); font-size: 13px;">加载中...</p>
    </div>
    <div id="listEmpty" style="text-align: center; padding: 40px; display: none;">
      <svg viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" width="48" height="48" style="margin-bottom: 12px; opacity: .4;">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
      </svg>
      <p style="color: var(--text-muted); font-size: 14px;">暂无处理记录，选择上方操作类型开始处理</p>
    </div>
    <div id="listWrap" style="overflow-x: auto; display: none;">
      <table class="pa-list-table">
        <thead>
          <tr>
            <th>类型</th>
            <th>平台 / 来源</th>
            <th>内容摘要</th>
            <th>状态</th>
            <th>备注</th>
            <th>提交时间</th>
            <th style="width: 60px;">操作</th>
          </tr>
        </thead>
        <tbody id="listBody"></tbody>
      </table>
    </div>
    <div id="listPager" style="padding: 12px 16px; display: flex; gap: 8px; justify-content: flex-end; border-top: 1px solid var(--border-color); display: none;"></div>
  </div>
</div>

<script>
var docroot = '${docroot}';
var currentAction = null;
var currentPage = 1;
var totalRecords = 0;

// ── 选择操作类型 ──
function selectAction(type) {
  // 清除之前选中
  document.querySelectorAll('.pa-action-card').forEach(function(c) {
    c.classList.remove('selected');
  });
  document.querySelectorAll('.pa-action-card.' + type).forEach(function(c) {
    c.classList.add('selected');
  });

  currentAction = type;
  var form = document.getElementById('actionForm');
  form.classList.add('visible');

  // 更新表单头
  var icons = {
    mask:   '<svg viewBox="0 0 24 24" fill="none" stroke="var(--accent-blue)" stroke-width="2" width="20" height="20"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>',
    hide:   '<svg viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" width="20" height="20"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>',
    delete: '<svg viewBox="0 0 24 24" fill="none" stroke="var(--accent-red)" stroke-width="2" width="20" height="20"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>',
  };
  var titles = { mask: '填写脱敏处理信息', hide: '填写隐藏申请信息', delete: '填写删除申请信息' };
  var hints = {
    mask:   '脱敏处理：粘贴完整文本，系统将对手机号、邮箱、地址等字段自动打码',
    hide:   '隐藏申请：填写或粘贴需要隐藏的内容链接/描述，系统将自动发起隐藏申请',
    delete: '删除申请：填写需要删除的内容链接或描述，系统将自动向平台提交删除请求并跟踪进度',
  };
  document.getElementById('formIconWrap').innerHTML = icons[type] || '';
  document.getElementById('formTitle').textContent = titles[type] || '';
  document.getElementById('contentHint').textContent = hints[type] || '';

  // 清空表单
  document.getElementById('pa-platform').value = '';
  document.getElementById('pa-content').value = '';
  document.getElementById('resultBox').style.display = 'none';
  document.getElementById('resultBox').textContent = '';
  document.getElementById('resultBox').className = 'pa-result-box';

  form.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function cancelAction() {
  currentAction = null;
  document.querySelectorAll('.pa-action-card').forEach(function(c) {
    c.classList.remove('selected');
  });
  document.getElementById('actionForm').classList.remove('visible');
}

// ── 提交处理任务 ──
function submitAction() {
  if (!currentAction) return;
  var platform = document.getElementById('pa-platform').value.trim();
  var content  = document.getElementById('pa-content').value.trim();

  if (!platform) { showMsg('请填写目标平台或内容来源', true); return; }
  if (!content)  { showMsg('请填写需要处理的内容', true); return; }

  document.getElementById('submitBtn').disabled = true;
  document.getElementById('submitSpinner').style.display = 'inline-block';
  document.getElementById('resultBox').style.display = 'none';

  var fd = new FormData();
  fd.append('action_type', currentAction);
  fd.append('platform', platform);
  fd.append('content', content);

  fetch(docroot + '/privacyactionsubmit', { method: 'POST', body: fd })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      document.getElementById('submitBtn').disabled = false;
      document.getElementById('submitSpinner').style.display = 'none';

      if (!data.success) {
        showMsg('提交失败：' + (data.error || '未知错误'), true);
        return;
      }

      var msgs = {
        mask:   '✅ 脱敏处理完成！\n\n处理结果：\n',
        hide:   '✅ 申请记录已保存，等待人工跟进；尚未向平台提交。\n\n记录ID：',
        delete: '✅ 申请记录已保存，等待人工跟进；尚未向平台提交。\n\n记录ID：',
      };

      var msg = msgs[currentAction] || '✅ 提交成功\n\n任务ID：';
      if (currentAction === 'mask' && data.masked_content) {
        msg += data.masked_content;
      } else {
        msg += data.id;
      }
      msg += '\n备注：' + (data.note || '');

      showMsg(msg, false);
      loadList();
      // 刷新统计
      updateStats(currentAction, data.status);
    })
    .catch(function() {
      document.getElementById('submitBtn').disabled = false;
      document.getElementById('submitSpinner').style.display = 'none';
      showMsg('提交失败，请稍后重试', true);
    });
}

function showMsg(text, isError) {
  var box = document.getElementById('resultBox');
  box.textContent = text;
  box.className = 'pa-result-box' + (isError ? ' error' : '');
  box.style.display = 'block';
}

// ── 加载任务列表 ──
function loadList(page) {
  page = page || 1;
  currentPage = page;

  document.getElementById('listLoading').style.display = 'block';
  document.getElementById('listEmpty').style.display = 'none';
  document.getElementById('listWrap').style.display = 'none';

  fetch(docroot + '/privacyactionlist?page=' + page + '&page_size=20')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      document.getElementById('listLoading').style.display = 'none';

      if (!data.success || !data.items || data.items.length === 0) {
        document.getElementById('listEmpty').style.display = 'block';
        return;
      }

      totalRecords = data.total || 0;
      var tbody = document.getElementById('listBody');
      tbody.innerHTML = '';

      data.items.forEach(function(item) {
        var tr = document.createElement('tr');
        tr.innerHTML =
          '<td>' + typeTag(item.action_type) + '</td>' +
          '<td style="max-width:130px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="' + escHtml(item.platform || '') + '">' + escHtml(item.platform || '-') + '</td>' +
          '<td style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="' + escHtml(item.content_preview || '') + '">' + escHtml(item.content_preview || '-') + '</td>' +
          '<td>' + statusTag(item.status) + '</td>' +
          '<td style="max-width:160px; color: var(--text-muted); font-size:12px;">' + escHtml(item.note || '-') + '</td>' +
          '<td style="font-size:12px; color:var(--text-muted); white-space:nowrap;">' + fmtTime(item.created_at) + '</td>' +
          '<td><button class="pg-btn pg-btn-sm" style="color:var(--accent-red); border-color:rgba(239,68,68,.3);" onclick="deleteRecord(\'' + item.id + '\')">删除</button></td>';
        tbody.appendChild(tr);
      });

      document.getElementById('listWrap').style.display = 'block';
      renderPager(data.total, page);
    })
    .catch(function() {
      document.getElementById('listLoading').style.display = 'none';
      document.getElementById('listEmpty').style.display = 'block';
    });
}

function deleteRecord(id) {
  if (!confirm('确定删除这条处理记录吗？')) return;
  fetch(docroot + '/privacyactiondelete', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
    body: new URLSearchParams({ action_id: id })
  })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        alertify.success('已删除');
        loadList(currentPage);
      } else {
        alertify.error('删除失败：' + (data.error || '未知错误'));
      }
    });
}

// ── 渲染分页器 ──
function renderPager(total, page) {
  var ps = 20;
  var pages = Math.ceil(total / ps);
  var pager = document.getElementById('listPager');
  if (pages <= 1) { pager.style.display = 'none'; return; }
  pager.style.display = 'flex';
  pager.innerHTML = '';

  var info = document.createElement('span');
  info.style.cssText = 'font-size:13px; color:var(--text-muted); flex:1;';
  info.textContent = '共 ' + total + ' 条 / 第 ' + page + '/' + pages + ' 页';
  pager.appendChild(info);

  if (page > 1) {
    var prev = mkBtn('上一页', function() { loadList(page - 1); });
    pager.appendChild(prev);
  }
  if (page < pages) {
    var next = mkBtn('下一页', function() { loadList(page + 1); });
    pager.appendChild(next);
  }
}

function mkBtn(label, fn) {
  var btn = document.createElement('button');
  btn.className = 'pg-btn pg-btn-sm';
  btn.textContent = label;
  btn.onclick = fn;
  return btn;
}

// ── 辅助函数 ──
function typeTag(t) {
  var map = {
    mask:   '<span class="pa-badge pa-badge-mask">脱敏</span>',
    hide:   '<span class="pa-badge pa-badge-hide">隐藏</span>',
    delete: '<span class="pa-badge pa-badge-delete">删除</span>',
  };
  return map[t] || t;
}

function statusTag(s) {
  var map = {
    done:       '<span class="pa-badge pa-badge-done">已完成</span>',
    processing: '<span class="pa-badge pa-badge-processing">处理中</span>',
    pending:    '<span class="pa-badge pa-badge-pending">等待中</span>',
    failed:     '<span class="pa-badge pa-badge-failed">失败</span>',
  };
  return map[s] || s;
}

function fmtTime(ts) {
  if (!ts) return '-';
  var d = new Date(ts * 1000);
  return d.toLocaleDateString('zh-CN') + ' ' + d.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
}

function escHtml(s) {
  if (!s) return '';
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function updateStats(type, status) {
  // 简单：成功提交后给对应统计 +1（精确统计请刷新页面）
  var ids = { mask: 'stat-mask', hide: 'stat-hide', delete: 'stat-delete' };
  var el = document.getElementById(ids[type]);
  if (el) el.textContent = parseInt(el.textContent || '0', 10) + 1;
  var tot = document.getElementById('stat-total');
  if (tot) tot.textContent = parseInt(tot.textContent || '0', 10) + 1;
}

// 页面加载后自动加载列表
document.addEventListener('DOMContentLoaded', function() { loadList(1); });
</script>

